<?php

declare(strict_types=1);

/**
 * PBMS — Property & Building Management System (Bamenda, Cameroon)
 * Single front controller for the modular monolith.
 */

define('PBMS', true);

require __DIR__ . '/core/bootstrap.php';

/**
 * Production safety net: fatals render a clean page (no stack traces,
 * no paths) instead of a blank 500. Database failures get a targeted
 * message pointing the operator at config/config.ini.
 */
set_exception_handler(static function (Throwable $e): void {
    $isDb = $e instanceof PDOException;
    http_response_code($isDb ? 503 : 500);
    if (\Core\Request::wantsJson()) {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode(['ok' => false, 'error' => $isDb ? 'database_unavailable' : 'server_error']);
        exit;
    }
    $title = $isDb ? 'Database unavailable' : 'Something went wrong';
    $detail = $isDb
        ? 'The system cannot reach its MySQL database. Operators: check <code>config/config.ini</code> '
          . 'credentials and confirm <code>database/schema.mysql.sql</code> was imported.'
        : 'The error has been logged. Please try again shortly.';
    echo "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"utf-8\">"
       . "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">"
       . "<title>$title · PBMS</title></head>"
       . "<body style=\"font:15px/1.6 system-ui,sans-serif;background:#f4f6f8;color:#17222b;"
       . "display:grid;place-items:center;min-height:96vh;margin:0\">"
       . "<div style=\"background:#fff;border:1px solid #dde4ea;border-radius:12px;"
       . "padding:32px 40px;max-width:520px;box-shadow:0 6px 24px rgba(23,34,43,.08)\">"
       . "<h1 style=\"margin:0 0 10px;font-size:20px\">⚠ $title</h1>"
       . "<p style=\"margin:0;color:#5c6b77\">$detail</p>"
       . "</div></body></html>";
    error_log('PBMS ' . ($isDb ? 'db' : 'fatal') . ': ' . $e->getMessage());
    exit;
});

$router = new Core\Router();
$router->loadModules();
$router->dispatch(Core\Request::route());
